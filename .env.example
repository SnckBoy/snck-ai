# =============================================================================
# Snck AI - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# PostgreSQL connection string (see docker-compose.yml for the local database)
DATABASE_URL="postgresql://snck:snck_dev_password@localhost:5432/snckai?schema=public"

# Secret used to sign session cookies / JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"

# 32-byte hex key used to encrypt AI provider API keys at rest. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY="replace-me-with-a-32-byte-hex-key"

# Public URL of the application (used for links, cookies, CORS)
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# docker-compose.yml variables (optional for local dev). The one-command
# Ubuntu VPS installer generates these automatically into /opt/snck-ai/.env.
# -----------------------------------------------------------------------------

# Password for the PostgreSQL user "snck" inside the compose database
DB_PASSWORD="snck_dev_password"

# Host port the app container is published on (defaults to 3000)
PORT=3000

# docker-compose only: seed a demo mock provider + models when the first
# (Owner) account registers, so chat works out of the box. Set to "false" to
# disable. Leave unset for plain local dev (no "mock" host there).
# SEED_DEMO_PROVIDER="true"

# Enforce a global rate limit for public routes (requests per minute per IP)
RATE_LIMIT_MAX=60

# Optional: log streaming/requests to stdout in dev (true/false)
DEBUG_STREAMS="false"
